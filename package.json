{
  "name": "sbom-parser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:sboms": "node scripts/fetch-artifacts.mjs",
    "build:snapshot": "node scripts/parse-sboms.mjs",
    "build": "npm run sync:sboms && npm run build:snapshot",
    "serve": "npx serve -s . -p 8080",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@octokit/rest": "20.1.2",
    "adm-zip": "^0.5.10",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "vitest": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9"
  },
  "overrides": {
    "test-exclude": {
      "glob": {
        "minimatch": "^3.1.3"
      }
    },
    "minimatch": "^10.2.3",
    "flatted": "^3.4.2",
    "@isaacs/brace-expansion": "^5.0.1",
    "postcss": "^8.5.10",
    "rollup": "^4.59.0",
    "esbuild": "^0.25.0"
  }
}
